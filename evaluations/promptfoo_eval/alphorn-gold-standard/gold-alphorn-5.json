        }
      ]
    },
    {
      "step": 2,
      "text": "The rating agency website generates a credit rating report for the online leasing service.",
      "main_activity": {
        "subject_id": "rating_agency_website",
        "action": "generates",
        "object_id": "credit_rating_report_1",
        "relation": "for",
        "target_id": "online_leasing_service"
      },
      "sub_activities": []
    },
    {
      "step": 3,
      "text": "The online leasing service creates a risk assessment for the contract and from the credit rating report in the risk management system.",
      "main_activity": {
        "subject_id": "online_leasing_service",
        "action": "creates",
        "object_id": "risk_assessment_1",
        "relation": null,
        "target_id": null
      },
      "sub_activities": [
        {
          "line_order": 2,
          "subject_id": "risk_assessment_1",
          "relation": "for",
          "target_id": "contract_2"
        },
        {
          "line_order": 3,
          "subject_id": "contract_2",
          "relation": "from",
          "target_id": "credit_rating_report_2"
        },
        {
          "line_order": 4,
          "subject_id": "credit_rating_report_1",
          "relation": "in",
          "target_id": "risk_management_system"
        }
      ]
    },
    {
      "step": 4,
      "text": "The online leasing service notifies the risk manager about the credit rating.",
      "main_activity": {
        "subject_id": "online_leasing_service",
        "action": "notifies about",
        "object_id": "credit_rating_2",
        "relation": "to",
        "target_id": "risk_manager"
      },
      "sub_activities": []
    },
    {
      "step": 5,
      "text": "The risk manager decides on a voting result for the risk assessment in the risk management system.",
      "main_activity": {
        "subject_id": "risk_manager",
        "action": "decides on",
        "object_id": "voting_result_1",
        "relation": null,
        "target_id": null
      },
      "sub_activities": [
        {
          "line_order": 2,
          "subject_id": "voting_result_1",
          "relation": "for",
          "target_id": "risk_assessment_2"
        },
        {
          "line_order": 3,
          "subject_id": "risk_assessment_2",
          "relation": "in",
          "target_id": "risk_management_system"
        }
      ]
    },
    {
      "step": 6,
      "text": "The risk manager signs the voted contract in the online leasing service.",
      "main_activity": {
        "subject_id": "risk_manager",
        "action": "signs",
        "object_id": "voted_contract_1",
        "relation": "in",
