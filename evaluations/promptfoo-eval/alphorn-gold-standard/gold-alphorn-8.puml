bank_account(bank_account_1, bank account)
bank_account(bank_account_2, bank account)
accounting_books(accounting_books_1, accounting books)
activity(1, customer, pays, monthly_installment_1, into, bank_account_1)
activity( , bank_account_1, at, bank)
activity(2, accountant, searches, monthly_installment_2, in, bank_account_2)
activity( , bank_account_2, at, bank)
activity(3, accountant, books, monthly_installment_3, into, accounting_books_1)
