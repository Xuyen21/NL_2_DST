@startuml
!include <domainstory/Domainstory>
!include <material/common>
!include <material/car>

!unquoted procedure Car($name, $label = "", $tag = "", $note = "", $shape = $Actor_Shape, $scale = $Actor_IconScale, $color = $Actor_IconColor, $background = "")
    Object("$id", "$ma_car", $name, $label, $tag, $note, $shape, $scale, $color, $background)
!endprocedure

!include <material/view_list>

!unquoted procedure Catalog($name, $label = "", $tag = "", $note = "", $shape = $Actor_Shape, $scale = $Actor_IconScale, $color = $Actor_IconColor, $background = "")
    Object("$id", "$ma_view_list", $name, $label, $tag, $note, $shape, $scale, $color, $background)
!endprocedure

!include <material/currency_eur>
!unquoted procedure Euro($name, $label = "", $tag = "", $note = "", $shape = $Actor_Shape, $scale = $Actor_IconScale, $color = $Actor_IconColor, $background = "")
    Object("$id", "$ma_currency_eur", $name, $label, $tag, $note, $shape, $scale, $color, $background)
!endprocedure


sprite mdiVoteOutline <svg width="48" height="48"><g transform="scale(2)"><path d="M18,13L21,16V20C21,21.11 20.1,22 19,22H5C3.89,22 3,21.1 3,20V16L6,13H6.83L8.83,15H6.78L5,17H19L17.23,15H15.32L17.32,13H18M19,20V19H5V20H19M11.34,15L6.39,10.07C6,9.68 6,9.05 6.39,8.66L12.76,2.29C13.15,1.9 13.78,1.9 14.16,2.3L19.11,7.25C19.5,7.64 19.5,8.27 19.11,8.66L12.75,15C12.36,15.41 11.73,15.41 11.34,15M13.46,4.41L8.5,9.36L12.05,12.9L17,7.95L13.46,4.41Z" /></g></svg>
!unquoted procedure Vote($name, $label="", $tag="", $note="", $shape=$Object_Shape, $scale=$Object_IconScale, $color=$Object_IconColor, $background="")
  Object("$id", "$mdiVoteOutline", $name, $label, $tag, $note, $shape, $scale, $color, $background)
!endprocedure

sprite mdiChartBoxOutline <svg width="48" height="48"><g transform="scale(2)"><path d="M9 17H7V10H9V17M13 17H11V7H13V17M17 17H15V13H17V17M19 19H5V5H19V19.1M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3Z" /></g></svg>
!unquoted procedure Report($name, $label = "", $tag = "", $note = "", $shape = $Actor_Shape, $scale = $Actor_IconScale, $color = $Actor_IconColor, $background = "")
  Object("$id", "$mdiChartBoxOutline", $name, $label, $tag, $note, $shape, $scale, $color, $background)
!endprocedure


Vote(vote, voting result)

Report(credit_rating, credit rating)
Report(credit_rating2, credit rating)



Euro(car_price, car price)

Person(risk_manager, risk manager, $color="DarkGreen", $scale=1.5)
Person(rating_agency, rating agency, $color="DarkGreen", $scale=1.5)

Document(contract, $label=contract)
Document(contract2, $label=contract)
Document(contract3, $label=voted contract)



activity(1, risk_manager, fetches, credit_rating, for, contract)
activity(, contract, from, rating_agency)
activity(2, risk_manager, votes, contract2, with, vote)
activity(, vote, based on, car_price)
activity(, vote, and, credit_rating2)
activity(3, risk_manager, signs, contract3)
@enduml